# Copy to .env and fill in. Never commit .env.
PORT=3000
HOST=localhost
COLYSEUS_PORT=3001

# YouTube live chat (one is enough)
YOUTUBE_VIDEO_ID=
YOUTUBE_API_KEY=
YOUTUBE_LIVE_CHAT_ID=
YOUTUBE_POLL_INTERVAL_MS=5000

# AI flag chat (optional — local fallback replies are used when empty)
OPENROUTER_API_KEY=

# Rate limiting for POST /api/chat.
# Without the two UPSTASH values the route runs UNLIMITED and logs a warning.
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CHAT_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW=1 m

# Colyseus engine URL used by the overlay in production
NEXT_PUBLIC_COLYSEUS_URL=ws://localhost:3001
